# Configuración de Firebase para el build de producción.
# Copia este archivo como .env.production.local y llena los valores de tu app web
# (Consola de Firebase → Configuración del proyecto → Tus apps).
# En desarrollo no hace falta: la app usa el emulador con el proyecto demo-quiz-repaso.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
