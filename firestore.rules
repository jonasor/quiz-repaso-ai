rules_version = '2';

// Estado inicial: todo cerrado.
//
// Las reglas reales de esta feature las construyen las tareas T018, T025,
// T027, T029, T031, T034 y T037 de specs/001-partida-integra/tasks.md, cada
// una con sus tests, según contracts/firestore-rules.md.
//
// El Principio IV de la constitución prohíbe modificar este archivo sin
// modificar tests/rules/. Cerrar por defecto es el punto de partida correcto:
// cada permiso que se abra a partir de aquí tiene que justificarse con su
// test de autorización, y cada denegación del catálogo con el suyo.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
